{
  "name": "@leobg/workspace",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve app -o",
    "build": "ng build app",
    "watch": "ng build app --watch --configuration development",
    "test": "ng test app",
    "lint": "eslint -- ./projects",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --write",
    "e2e": "cypress open",
    "deploy": "ng build app --configuration=production && firebase deploy",
    "firebase:login": "firebase login",
    "firebase:logout": "firebase logout",
    "cypress": "cypress open"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "22.1.2",
    "@angular/cdk": "21.2.14",
    "@angular/common": "22.1.2",
    "@angular/compiler": "22.1.2",
    "@angular/core": "22.1.2",
    "@angular/forms": "22.1.2",
    "@angular/platform-browser": "22.1.2",
    "@angular/router": "22.1.2",
    "@ngrx/signals": "21.1.1",
    "@taiga-ui/addon-mobile": "^5.21.0",
    "@taiga-ui/addon-table": "^5.21.0",
    "@taiga-ui/cdk": "^5.21.0",
    "@taiga-ui/core": "^5.21.0",
    "@taiga-ui/icons": "^5.21.0",
    "@taiga-ui/kit": "^5.21.0",
    "firebase": "^12.17.1",
    "rxjs": "7.8.0",
    "tslib": "2.3.1"
  },
  "devDependencies": {
    "@angular/build": "^22.1.4",
    "@angular/cli": "^22.1.4",
    "@angular/compiler-cli": "^22.1.0",
    "@eslint/js": "^10.0.1",
    "angular-eslint": "^22.2.0",
    "eslint": "^10.9.1",
    "firebase-tools": "^15.27.0",
    "jsdom": "^28.0.0",
    "ng-packagr": "22.1.1",
    "prettier": "^3.8.1",
    "taiga-ui": "^5.21.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.69.0",
    "vitest": "^4.0.8"
  },
  "overrides": {
    "@ngrx/signals": {
      "@angular/common": "$@angular/common",
      "@angular/core": "$@angular/core"
    }
  }
