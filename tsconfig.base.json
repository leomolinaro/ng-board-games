{
  "compileOnSave": false,
  "compilerOptions": {
    "noImplicitOverride": true,
    "noPropertyAccessFromIndexSignature": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "ES2022",
    "module": "preserve",
    "baseUrl": "./",
    "ignoreDeprecations": "6.0",
    "paths": {
      "@leobg/agot": ["projects/agot/src/index.ts"],
      "@leobg/barony": ["projects/barony/src/index.ts"],
      "@leobg/britannia": ["projects/britannia/src/index.ts"],
      "@leobg/commons": ["projects/commons/src/index.ts"],
      "@leobg/commons/utils": ["projects/commons/utils/src/index.ts"],
      "@leobg/talisman": ["projects/talisman/src/index.ts"],
      "@leobg/wotr": ["projects/wotr/src/index.ts"]
    }
  },
  "angularCompilerOptions": {
    "enableI18nLegacyMessageIdFormat": false,
    "strictInjectionParameters": true,
    "strictInputAccessModifiers": true,
    "strictInputTypes": false
  },
  "exclude": ["node_modules", "tmp"]
}
