{
  "compileOnSave": false,
  "compilerOptions": {
    "noImplicitOverride": true,
    "noPropertyAccessFromIndexSignature": true,
    "noImplicitReturns": true,
    "paths": {
      "@leobg/agot": ["./projects/agot/src/index.ts"],
      "@leobg/barony": ["./projects/barony/src/index.ts"],
      "@leobg/britannia": ["./projects/britannia/src/index.ts"],
      "@leobg/commons": ["./projects/commons/src/index.ts"],
      "@leobg/commons/utils": ["./projects/commons/utils/src/index.ts"],
      "@leobg/talisman": ["./projects/talisman/src/index.ts"],
      "@leobg/wotr": ["./projects/wotr/src/index.ts"]
    },
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "ES2022",
    "module": "preserve"
  },
  "angularCompilerOptions": {
    "enableI18nLegacyMessageIdFormat": false,
    "strictInjectionParameters": true,
    "strictInputAccessModifiers": true
  },
  "files": [],
  "references": [
    { "path": "./projects/agot/tsconfig.lib.json" },
    { "path": "./projects/app/tsconfig.app.json" },
    { "path": "./projects/barony/tsconfig.lib.json" },
    { "path": "./projects/britannia/tsconfig.lib.json" },
    { "path": "./projects/commons/tsconfig.lib.json" },
    { "path": "./projects/talisman/tsconfig.lib.json" },
    { "path": "./projects/wotr/tsconfig.lib.json" }
  ]
}
